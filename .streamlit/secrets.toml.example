# Paste into Streamlit Community Cloud > Advanced settings > Secrets.
# Replace only the placeholder API key. Do not commit real secrets.
LLM_PROVIDER = "groq"
LLM_MODEL = "openai/gpt-oss-120b"
LLM_API_KEY = "REPLACE_WITH_YOUR_GROQ_KEY"
REVIEW_STORAGE = "sqlite"

# Optional durable backend instead of SQLite:
# REVIEW_STORAGE = "postgres"
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
