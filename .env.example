# Server-side secrets only. Copy to .env locally, or add to Streamlit secrets.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Optional override; groq defaults to https://api.groq.com/openai/v1
LLM_BASE_URL=
# SQLite requires no separate service; created automatically on opening Review.
REVIEW_STORAGE=sqlite
# Optional local path; default data/reviews.db (not committed to Git).
REVIEW_SQLITE_PATH=
# Optional: REVIEW_STORAGE=postgres and a managed Postgres URL for durable hosting.
DATABASE_URL=
